APP_NAME="UUIDTools.com"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.uuidtools.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# No database is required. Cache (used for API rate limiting) lives on disk.
CACHE_STORE=file

# Optional: Google AdSense publisher id (e.g. ca-pub-0000000000000000) and GA4 measurement id (e.g. G-XXXXXXXXXX).
# Leave empty to disable. Scripts are only included when APP_ENV=production.
ADSENSE_CLIENT=ca-pub-0583047843012866
GOOGLE_ANALYTICS_ID=

# API requests allowed per minute per IP.
API_RATE_LIMIT=60
