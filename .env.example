APP_NAME="UUIDTools.com"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.uuidtools.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# No database is required. Cache (used for API rate limiting) lives on disk.
CACHE_STORE=file

# Ads and analytics scripts are only included when APP_ENV=production.
# Google AdSense publisher id. Leave empty to disable.
ADSENSE_CLIENT=ca-pub-0583047843012866
# GA4 measurement id. Empty uses the default (G-2SCNGWDT9C); set to false to disable.
GOOGLE_ANALYTICS_ID=
# Cloudflare Web Analytics token (Web Analytics > site > Manage site > JS snippet). Empty disables the beacon.
CLOUDFLARE_ANALYTICS_TOKEN=

# API requests allowed per minute per IP.
API_RATE_LIMIT=60
